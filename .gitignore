# caelestia/ is the live ~/.config/caelestia (symlinked), so only allowlisted
# files are tracked; the HA token, backups and anything else stay local.
/caelestia/*
!/caelestia/shell.json
!/caelestia/cli.json
!/caelestia/lock-ha.json
!/caelestia/assets/
!/caelestia/monitors/
/caelestia/monitors/*
!/caelestia/monitors/*/
!/caelestia/monitors/*/shell.json

__pycache__/

# fontconfig cache marker
.uuid
