pkgbase = caelestia-plus-git
	pkgver = 2.5.0
	pkgrel = 1
	url = https://github.com/moimart/caelestia-plus
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	makedepends = cmake
	makedepends = ninja
	makedepends = git
	makedepends = qt6-shadertools
	makedepends = cargo
	makedepends = clang
	makedepends = qt6-base
	makedepends = qt6-declarative
	makedepends = qt6-multimedia
	makedepends = aubio
	makedepends = libcava
	makedepends = libpipewire
	makedepends = libqalculate
	noextract = face_detection_yunet_2023mar.onnx
	noextract = palm_detection_mediapipe_2023feb.onnx
	noextract = handpose_estimation_mediapipe_2023feb.onnx
	source = caelestia-plus::git+https://github.com/moimart/caelestia-plus.git
	source = m3shapes::git+https://github.com/soramanew/m3shapes.git
	source = https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx
	source = https://github.com/opencv/opencv_zoo/raw/main/models/palm_detection_mediapipe/palm_detection_mediapipe_2023feb.onnx
	source = https://github.com/opencv/opencv_zoo/raw/main/models/handpose_estimation_mediapipe/handpose_estimation_mediapipe_2023feb.onnx
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = 8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4
	sha256sums = 78ff51c38496b7fc8b8ebdb6cc8c1abb02fa6c38427c6848254cdaba57fcce7c
	sha256sums = db0898ae717b76b075d9bf563af315b29562e11f8df5027a1ef07b02bef6d81c

pkgname = caelestia-plus
	pkgdesc = A Caelestia-based Hyprland desktop: the shell, Hyprland config and app configs
	depends = caelestia-shell-moimart
	depends = caelestia-plus-hypr
	depends = caelestia-plus-config

pkgname = caelestia-shell-moimart
	pkgdesc = The desktop shell for the Caelestia dotfiles (moimart fork)
	depends = caelestia-cli
	depends = quickshell-git
	depends = glibc
	depends = gcc-libs
	depends = ddcutil
	depends = brightnessctl
	depends = libcava
	depends = networkmanager
	depends = lm_sensors
	depends = aubio
	depends = libpipewire
	depends = libqalculate
	depends = power-profiles-daemon
	depends = ttf-material-symbols-variable
	depends = ttf-rubik-vf
	depends = ttf-cascadia-code-nerd
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-imageformats
	depends = qt6-multimedia
	depends = swappy
	depends = wtype
	depends = fish
	depends = bash
	optdepends = fprintd: fingerprint unlock for the lock screen
	optdepends = mpvpaper: video wallpapers
	optdepends = ffmpeg: video wallpaper posters and thumbnails, camera recordings
	optdepends = onnxruntime-cpu: camera presence, gestures (caelestia-camerad)
	optdepends = howdy: face unlock on the lock screen
	provides = caelestia-shell
	provides = qt6-m3shapes
	conflicts = caelestia-shell
	conflicts = caelestia-shell-git
	conflicts = qt6-m3shapes-git

pkgname = caelestia-plus-hypr
	pkgdesc = The caelestia-plus Hyprland config (Lua), with host profiles
	depends = hyprland
	depends = hypridle
	depends = xdg-desktop-portal-hyprland
	depends = uwsm
	depends = app2unit
	depends = caelestia-cli
	depends = polkit-gnome
	depends = gcr-4
	depends = cliphist
	depends = wl-clipboard
	depends = bluez-utils
	depends = capitaine-cursors
	depends = fish
	depends = kitty
	optdepends = gammastep: warmer colours in the evening (with geoclue for your location)
	optdepends = geoclue: your location, for gammastep
	optdepends = qt6ct: Qt app theming (the config sets QT_QPA_PLATFORMTHEME=qt6ct)
	optdepends = trash-cli: empty trash older than 30 days at login
	optdepends = google-chrome: the default browser (SUPER + SHIFT + B)
	optdepends = nautilus: the default file manager (SUPER + SHIFT + F)
	optdepends = vim: the default editor (SUPER + C)

pkgname = caelestia-plus-config
	pkgdesc = caelestia-plus defaults: the shell config and art, app configs, scripts, fonts and caelestia-plus-setup
	depends = caelestia-shell-moimart
	depends = fish
	depends = starship
	depends = eza
	depends = kitty
	depends = fastfetch
	depends = python
	depends = bash
	depends = git
	optdepends = foot: alternative terminal
	optdepends = ghostty: alternative terminal, with an amber CRT shader
	optdepends = btop: system monitor
	optdepends = micro: terminal editor
	optdepends = direnv: per-directory environments in fish
	optdepends = lazygit: the lg abbreviation in fish
	optdepends = zoxide: a smarter cd in fish
	backup = etc/xdg/caelestia/shell.json
