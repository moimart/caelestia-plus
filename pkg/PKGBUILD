# Builds this fork as a drop-in replacement for the AUR caelestia-shell.
#   cd pkg && makepkg -si
# Builds the commit checked out in the repo this PKGBUILD lives in.

pkgname='caelestia-shell-moimart'
pkgver=2.3.0
pkgrel=1
pkgdesc='The desktop shell for the Caelestia dotfiles (moimart fork)'
arch=('x86_64' 'aarch64')
url='https://github.com/moimart/caelestia-shell'
license=('GPL-3.0-only')
depends=(
    'caelestia-cli'
    'quickshell-git'
    'glibc'
    'gcc-libs'

    # Brightness
    'ddcutil'
    'brightnessctl'

    # Services
    'libcava'
    'networkmanager'
    'lm_sensors'
    'aubio'
    'libpipewire'
    'libqalculate'
    'power-profiles-daemon'

    # Fonts
    'ttf-material-symbols-variable'
    'ttf-rubik-vf'
    'ttf-cascadia-code-nerd'

    # Qt modules
    'qt6-base'
    'qt6-declarative'
    'qt6-imageformats'
    'qt6-multimedia'

    # Extra functionality
    'swappy'
    'fish'
    'bash'
)
optdepends=(
    'fprintd: fingerprint unlock for the lock screen'
    'mpvpaper: video wallpapers'
    'ffmpeg: video wallpaper posters and thumbnails'
)
makedepends=('cmake' 'ninja' 'git' 'qt6-shadertools')
# Upstream split M3Shapes (Material shapes QML module) out of the shell build;
# it's built here too so this stays a single package.
provides=('caelestia-shell' 'qt6-m3shapes')
conflicts=('caelestia-shell' 'caelestia-shell-git' 'qt6-m3shapes-git')
source=("${pkgname}::git+file://$(realpath "${startdir}/..")"
        "m3shapes::git+https://github.com/soramanew/m3shapes.git")
sha256sums=('SKIP' 'SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    git describe --long --tags --match 'v*' | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
}

build() {
    cmake -S "${srcdir}/m3shapes" -B "${srcdir}/build-m3shapes" -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "${srcdir}/build-m3shapes"

    cd "${srcdir}/${pkgname}"

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/ \
        -DVERSION="$(git describe --tags --abbrev=0 | sed 's/^v//')" \
        -DGIT_REVISION="$(git rev-parse HEAD)" \
        -DDISTRIBUTOR="moimart (package: ${pkgname})"
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install "${srcdir}/build-m3shapes"

    cd "${srcdir}/${pkgname}"

    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
